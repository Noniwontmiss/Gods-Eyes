# RPC endpoints. Use an HTTPS RPC from your preferred provider.
ETH_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
DEGEN_RPC_URL=

# Existing Telegram bot/channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Polling / reliability
POLL_INTERVAL_MS=3000
CONFIRMATIONS=1
BLOCK_CHUNK_SIZE=1000

# Safety: start watching from the current head on first run.
# This prevents a first run from flooding the channel with old bounties.
START_FROM_CURRENT=true

# Optional per-chain historical start blocks.
# Only used when START_FROM_CURRENT=false.
# Leave blank to use each chain's current head at startup.
ETH_START_BLOCK=
ARBITRUM_START_BLOCK=
BASE_START_BLOCK=
DEGEN_START_BLOCK=
